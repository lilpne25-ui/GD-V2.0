# ==============================
# SGC - Variables de entorno
# Uso recomendado:
# - Desarrollo: copiar a .env y ajustar valores
# - Producción: definir en runtime o en %APPDATA%/<TuApp>/.env
# ==============================

# Usuario objetivo para seed opcional
SGC_EMAIL_USER_ID=org-016

# SMTP
SGC_SMTP_HOST=
SGC_SMTP_PORT=465
SGC_SMTP_USER=
SGC_SMTP_PASS=
SGC_SMTP_FROM=
SGC_SMTP_SECURE=1

# IMAP
SGC_IMAP_HOST=
SGC_IMAP_PORT=993
SGC_IMAP_SECURE=1

# POP3
SGC_POP_HOST=
SGC_POP_PORT=995
SGC_POP_SECURE=1

# Permisos iniciales
SGC_CAN_SEND_EMAIL=1
SGC_CAN_RECEIVE_EMAIL=1

# En producción mantener en 0 para NO sobrescribir configuraciones por usuario
SGC_EMAIL_FORCE_APPLY=0

# ==============================
# SQL Server (MSSQL)
# ==============================
SGC_DB_SERVER=localhost
SGC_DB_PORT=1433
SGC_DB_DATABASE=SGC_Dev
# Dejar en blanco para autenticación integrada de Windows
SGC_DB_USER=
SGC_DB_PASSWORD=
SGC_DB_TRUSTED=1
SGC_DB_ENCRYPT=0
SGC_DB_TRUST_CERT=1
SGC_DB_POOL_MAX=10

# ==============================
# RAG / DeepSeek
# ==============================
SGC_RAG_ENABLED=0
SGC_RAG_FP05_ENABLED=1
SGC_RAG_FP08_ENABLED=0
SGC_RAG_ONLY_CACHE_MODE=0
SGC_RAG_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000

# Embeddings desacoplados: local | openai_compatible | ollama
SGC_RAG_EMBEDDINGS_PROVIDER=local
SGC_RAG_EMBEDDINGS_BASE_URL=
SGC_RAG_EMBEDDINGS_API_KEY=
SGC_RAG_EMBEDDINGS_MODEL=local-hash-v1
SGC_RAG_EMBEDDINGS_DIMS=128
SGC_RAG_EMBEDDINGS_TIMEOUT_MS=30000
SGC_RAG_TOP_K=8
SGC_RAG_CONTEXT_TOKEN_BUDGET=6000
SGC_RAG_MAX_FILE_MB=15
SGC_RAG_DAILY_BUDGET_USD=1
SGC_RAG_MONTHLY_BUDGET_USD=20
SGC_RAG_ESTIMATED_REQUEST_COST_USD=0.01
SGC_RAG_INPUT_TOKEN_USD_PER_1K=0
SGC_RAG_OUTPUT_TOKEN_USD_PER_1K=0
SGC_RAG_RATE_LIMIT_PER_MINUTE=6
SGC_RAG_RATE_LIMIT_PER_DAY=60

# ==============================
# Fase 0.5 - Seguridad
# ==============================
# Raices autorizadas para lectura de archivos desde el renderer.
# Separadas por ';' o ','. Sin este valor, TODO acceso a archivos se deniega.
# Ejemplo: D:\SGC\Documentos;\servidor\calidad\evidencias
SGC_ALLOWED_FILE_ROOTS=

# Bootstrap del primer administrador (solo para npm run bootstrap:admin).
# Sin valor por defecto: el script aborta si no se definen.
SGC_BOOTSTRAP_ADMIN_LOGIN=
SGC_BOOTSTRAP_ADMIN_PASSWORD=

# Siembra de credenciales SOLO en desarrollo (NODE_ENV=development).
# Sin fallback: si no se define, no se siembra nada.
SGC_DEV_SEED_PASSWORD=
