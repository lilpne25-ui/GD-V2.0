{
  "name": "sgc-desktop-app",
  "version": "0.1.0",
  "description": "Sistema de Gestión de Calidad (SGC) multiplataforma con Electron, React y SQLite",
  "main": "dist/main.bundle.js",
  "author": "Equipo SGC",
  "license": "MIT",
  "build": {
    "appId": "com.sgc.desktop",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/*.map",
      "!src/**/*",
      "!.env",
      "!.env.*"
    ],
    "extraResources": [
      {
        "from": "src/database/migrations",
        "to": "migrations",
        "filter": [
          "*.sql"
        ]
      },
      {
        "from": "src/database/migrations-mssql",
        "to": "migrations-mssql",
        "filter": [
          "*.sql"
        ]
      }
    ]
  },
  "scripts": {
    "start": "concurrently \"npm:dev:react\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:react": "webpack serve --config webpack.renderer.js --mode development --host 0.0.0.0",
    "dev:main": "webpack --config webpack.main.js --mode development --watch",
    "dev:electron": "wait-on tcp:3002 dist/main.bundle.js && electron .",
    "rebuild:native": "electron-rebuild -f -w sqlite3",
    "migrate:data:sqlite-to-mssql": "node scripts/migrate-sqlite-to-mssql.js",
    "typecheck": "tsc --noEmit",
    "smoke:rag": "node scripts/rag-smoke-mssql.js",
    "build": "webpack --config webpack.renderer.js --mode production && webpack --config webpack.main.js --mode production && electron-builder"
  },
  "dependencies": {
    "docx": "^9.6.0",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "mammoth": "^1.11.0",
    "msnodesqlv8": "^5.1.5",
    "mssql": "^11.0.1",
    "nodemailer": "^8.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sqlite3": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/mssql": "^9.1.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.0.0",
    "css-loader": "^7.1.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.6.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.0.0"
  }
}
